OTP_DEFAULTS = [
    # "Seu código de acesso à conta é: 000000"
    r"(?i)c[oó]digo\s+de\s+acesso[^0-9\n]{0,40}?(?<!\d)(\d{4,8})(?!\d)",
    # genérico: palavra-chave seguida do código
    r"(?i)(?:otp|c[oó]digo|token|verifica[cç][aã]o)[^0-9\n]{0,60}?(?<!\d)(\d{4,8})(?!\d)",
]

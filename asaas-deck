def setting(key, default=None):
    return os.environ.get("ASAAS_" + key.upper(), CONFIG.get(key, default))


def _find_project():
    """asaas-core pode estar em ~/Documents/Asaas, no volume case-sensitive, ou no home."""
    explicit = setting("core_dir")
    if explicit:
        return os.path.expanduser(explicit)
    for cand in (os.path.join(HOME, "Documents/Asaas/asaas-core"),
                 "/Volumes/workspace/asaas-core",
                 os.path.join(HOME, "Documents/asaas-core"),
                 os.path.join(HOME, "asaas-core"),
                 os.path.join(HOME, "Projects/asaas-core")):
        if os.path.isdir(os.path.join(cand, "web")):
            return cand
    return os.path.join(HOME, "Documents/Asaas/asaas-core")


def _find_mobile():
    """Repos mobile: mesma busca, tolerante a quem não os tem clonados."""
    rel = "App/Shared/Asaas.Instance/Shared/Development/DebugSettings.cs"
    out = []
    for repo in ("AsaasMobile", "AsaasMobile-Platform"):
        explicit = setting(repo.replace("-", "_").lower() + "_dir")
        roots = [os.path.expanduser(explicit)] if explicit else [
            os.path.join(HOME, "Documents", repo), os.path.join(HOME, repo),
            os.path.join("/Volumes/workspace", repo), os.path.join(HOME, "Projects", repo)]
        chosen = next((r for r in roots if os.path.isfile(os.path.join(r, rel))), roots[0])
        out.append((repo, os.path.join(chosen, rel)))
    return out



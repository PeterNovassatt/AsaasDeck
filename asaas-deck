_docker_cache = {"t": 0.0, "data": None}

# Quanto tempo o console serial da VM pode ficar sem escrita antes de considerarmos
# o guest travado. O Rancher escreve ali de forma esparsa, então o limite é folgado.
FROZEN_AFTER = 600


def docker_health(ttl=6.0):
    """Diagnostica o Docker distinguindo *por que* ele está fora, não só *se* está.

    O caso que mais custa tempo é a VM congelada: o processo qemu segue vivo e o
    `limactl list` reporta Running, mas o guest está morto e o dockerd nunca sobe.
    Usamos apenas sinais do lado do host — nada aqui pode tocar o guest, porque
    `limactl shell` trava por minutos exatamente quando a VM está nesse estado.
    """
    now = time.time()
    if _docker_cache["data"] and now - _docker_cache["t"] < ttl:
        return _docker_cache["data"]

    version = sh("docker info --format '{{.ServerVersion}}' 2>/dev/null", timeout=4)
    if version:
        info = {"state": "ok", "version": version, "label": "ativo"}
    else:
        vm = bool(sh("pgrep -f 'lima/bin/qemu-system|lima/bin/limactl hostagent'", timeout=3))
        app = bool(sh("pgrep -f 'Rancher Desktop.app/Contents/MacOS'", timeout=3))
        if vm:
            # VM de pé sem engine respondendo: congelada. A idade do serial.log
            # confirma e vira a explicação mostrada no painel.
            stale = ""
            try:
                age = int(now - os.path.getmtime(LIMA_SERIAL))
                if age > FROZEN_AFTER:
                    stale = f"console da VM parado há {_human(age)}"
            except OSError:
                pass
            info = {"state": "frozen", "version": "",
                    "label": "VM congelada", "detail": stale}
        elif app:
            info = {"state": "vm_stopped", "version": "", "label": "VM parada",
                    "detail": "Rancher aberto, mas a VM não está de pé"}
        else:
            info = {"state": "app_closed", "version": "", "label": "Rancher fechado",
                    "detail": "o Rancher Desktop não está em execução"}
    info["fixable"] = info["state"] != "ok" and bool(RDCTL)
    _docker_cache.update(t=now, data=info)
    return info


def _human(seconds):
    if seconds >= 86400:
        return f"{seconds // 86400}d{(seconds % 86400) // 3600:02d}h"
    if seconds >= 3600:
        return f"{seconds // 3600}h{(seconds % 3600) // 60:02d}"
    return f"{seconds // 60}min"


RIDER_UI = "Rider.app/Contents/MacOS/rider"
_rider_cache = {"t": 0.0, "data": None}
def _etime_seconds(etime):
    """O ps do macOS não tem `etimes`; converte o [[dd-]hh:]mm:ss em segundos."""
    days, _, rest = etime.rpartition("-")
    parts = rest.split(":")
    if not all(p.isdigit() for p in parts) or not parts:
        return 0
    total = 0
    for part in parts:
        total = total * 60 + int(part)
    return total + (int(days) * 86400 if days.isdigit() else 0)


def _ps_table():
    """Uma única leitura de ps para todo o diagnóstico do Rider."""
    rows = []
    for line in sh("ps -Aww -o pid=,ppid=,etime=,args=", timeout=6).split("\n"):
        parts = line.strip().split(None, 3)
        if len(parts) < 4 or not parts[0].isdigit():
            continue
        rows.append({"pid": int(parts[0]), "ppid": int(parts[1]),
                     "etimes": _etime_seconds(parts[2]), "args": parts[3]})
    return rows


def _kind(args):
    if "MSBuild.dll" in args:
        return "nó de MSBuild"
    if "Roslyn.Worker" in args:
        return "worker do Roslyn"
    if "Rider.Backend" in args:
        return "backend do Rider"
    if "JetBrains." in args:
        return "worker da JetBrains"
    return "processo auxiliar"


def rider_scan():
    """Separa o que é sessão viva do que ficou para trás.

    O backend do Rider é filho da janela; quando a janela morre mal, ele fica com
    ppid 1 e continua segurando a solution, o que trava build, deploy e debug com o
    botão de cancelar sempre aceso. Os nós de MSBuild e workers pendurados nele são
    reparentados ou seguem como filhos e vao junto.
    """
    rows = _ps_table()
    by_parent = {}
    for row in rows:
        by_parent.setdefault(row["ppid"], []).append(row)

    ui = [r for r in rows if RIDER_UI in r["args"]]
    ui_pids = {r["pid"] for r in ui}
    backends = [r for r in rows if "Rider.Backend" in r["args"]]
    live = [b for b in backends if b["ppid"] in ui_pids]

    stuck = []
    for backend in backends:
        if backend["ppid"] in ui_pids:
            continue
        stuck.append(dict(backend, kind="backend do Rider órfão", owner=None))
        for child in by_parent.get(backend["pid"], []):
            stuck.append(dict(child, kind=_kind(child["args"]), owner=backend["pid"]))

    for row in rows:
        if row["ppid"] != 1 or row in stuck:
            continue
        orphan_helper = ("ReSharperHost" in row["args"] or "JetBrains." in row["args"]) \
            and "Rider.Backend" not in row["args"] and RIDER_UI not in row["args"]
        if orphan_helper:
            stuck.append(dict(row, kind=_kind(row["args"]) + " órfão", owner=None))

    return {"ui": ui, "live": live, "stuck": stuck}


def rider_health(ttl=6.0):
    now = time.time()
    if _rider_cache["data"] and now - _rider_cache["t"] < ttl:
        return _rider_cache["data"]

    scan = rider_scan()
    stuck = sorted(scan["stuck"], key=lambda p: -p["etimes"])
    items = [{"pid": p["pid"], "kind": p["kind"], "age": _human(p["etimes"]),
              "owner": p.get("owner")} for p in stuck]

    if stuck:
        oldest = _human(stuck[0]["etimes"])
        backends = sum(1 for p in stuck if "backend" in p["kind"])
        detail = f"{len(stuck)} processo(s) preso(s), o mais antigo há {oldest}"
        if backends:
            detail += f" — {backends} backend(s) sem janela segurando a solution"
        info = {"state": "stuck", "label": "processos presos", "detail": detail}
    elif scan["ui"]:
        info = {"state": "ok", "label": "ativo",
                "detail": f"PID {scan['ui'][0]['pid']} · up {_human(scan['ui'][0]['etimes'])}"}
    else:
        info = {"state": "closed", "label": "fechado", "detail": "o Rider não está em execução"}

    info["items"] = items
    info["open"] = bool(scan["ui"])
    info["fixable"] = bool(RIDER_APP) and (bool(stuck) or bool(scan["ui"]))
    _rider_cache.update(t=now, data=info)
    return info


def action_rider_diag():
    """Escreve no log o retrato do que está segurando o Rider, sem matar nada."""
    scan = rider_scan()
    health = rider_health(ttl=0)
    out = [f"$ diagnóstico do Rider — {time.strftime('%H:%M:%S')}", ""]

    if scan["ui"]:
        for window in scan["ui"]:
            out.append(f"Janela do Rider   PID {window['pid']:<7} up {_human(window['etimes'])}")
        for backend in scan["live"]:
            out.append(f"  backend em uso  PID {backend['pid']:<7} up {_human(backend['etimes'])}"
                       f" (filho do {backend['ppid']})")
    else:
        out.append("Janela do Rider   nenhuma em execução")

    out.append("")
    if health["items"]:
        out.append("Processos presos:")
        for item in health["items"]:
            owner = f" (filho do {item['owner']})" if item["owner"] else " (sem janela, ppid 1)"
            out.append(f"  · PID {item['pid']:<7} {item['kind']}{owner} — há {item['age']}")
    else:
        out.append("Processos presos: nenhum")

    servers = sh("pgrep -fl 'VBCSCompiler|MSBuildTaskHost|dotnet build-server'", timeout=4)
    out.append("")
    out.append("Build servers do dotnet: " + (servers.replace("\n", " | ") if servers else "nenhum"))

    out.append("")
    if health["state"] == "stuck":
        out.append(f"Veredito: {health['detail']}.")
        out.append("Ação: 'Reiniciar Rider' encerra a janela, mata esses processos e reabre o Rider.")
    elif health["state"] == "closed":
        out.append("Veredito: nada preso e nenhuma janela aberta.")
    else:
        out.append("Veredito: sessão saudável, nada preso.")

    try:
        with open(TASK_LOG, "w", encoding="utf-8") as fh:
            fh.write("\n".join(out) + "\n")
    except OSError as exc:
        return False, f"falha ao gravar o log: {exc}"
    _rider_cache["t"] = 0.0
    count = len(health["items"])
    if count:
        return True, f"{count} processo(s) preso(s) — detalhes no log"
    return True, "nenhum processo preso — detalhes no log"


def action_rider_fix():
    """Encerra o Rider, limpa o que ficou pendurado e reabre.

    Fechar pelo osascript preserva a sessão (abas, breakpoints, última solution);
    o kill só entra para o que sobrar depois do prazo. Os PIDs presos são apurados
    antes, para o comando mirar exatamente neles em vez de varrer por padrao.
    """
    if not RIDER_APP:
        return False, "Rider não encontrado — defina ASAAS_RIDER_APP com o caminho do .app"

    health = rider_health(ttl=0)
    pids = " ".join(str(item["pid"]) for item in health["items"])
    stuck_count = len(health["items"])
    kill_stuck = ""
    if pids:
        kill_stuck = ("echo '--- encerrando " + str(stuck_count) + " processo(s) preso(s)' && "
                      "kill -TERM " + pids + " 2>/dev/null; sleep 3; "
                      "kill -KILL " + pids + " 2>/dev/null; ")

    cmd = ("echo '--- encerrando o Rider (até 30s)' && "
           "osascript -e 'quit app \"Rider\"' >/dev/null 2>&1 || true; "
           "for i in $(seq 1 30); do pgrep -f '" + RIDER_UI + "' >/dev/null || break; sleep 1; done; "
           "pgrep -f '" + RIDER_UI + "' >/dev/null && "
           "  { echo 'a janela não fechou sozinha — encerrando'; "
           "    pkill -TERM -f '" + RIDER_UI + "' 2>/dev/null; sleep 4; "
           "    pkill -KILL -f '" + RIDER_UI + "' 2>/dev/null; }; "
           + kill_stuck +
           "echo '--- limpando backends remanescentes'; "
           "pkill -TERM -f 'ReSharperHost.*Rider.Backend' 2>/dev/null; sleep 3; "
           "pkill -KILL -f 'ReSharperHost.*Rider.Backend' 2>/dev/null; "
           "echo '--- encerrando os build servers do dotnet (até 20s)'; "
           "( dotnet build-server shutdown >/dev/null 2>&1 & BS=$!; "
           "  for i in $(seq 1 20); do kill -0 $BS 2>/dev/null || break; sleep 1; done; "
           "  kill -KILL $BS 2>/dev/null ) ; "
           "sleep 2; echo '--- reabrindo o Rider'; "
           "open -a '" + RIDER_APP + "' && "
           "echo 'Rider reaberto — o backend leva alguns segundos para indexar'")

    ok, msg = run_task("rider-fix", cmd, TASK_LOG)
    if ok:
        _rider_cache["t"] = 0.0
        return True, "reiniciando o Rider — acompanhe no log (leva ~30-60s)"
    return ok, msg


def status():
    app = port_pids(APP_PORT)
    boot = bootrun_pids()
    if app:
        state = "running"
        if _task["name"] == "start":
            _task["name"] = None
    elif boot or _task["name"] == "start":
        state = "starting"
    else:
        state = "stopped"
    uptime = ""
    if app:
        uptime = sh(f"ps -p {app[0]} -o etime= 2>/dev/null").strip()
    ip, iface = local_ip()
    return {
        "mobile": mobile_status(ip),
        "otp": find_otp(),
        "state": state,
        "task": _task["name"],
        "task_elapsed": int(time.time() - _task["started"]) if _task["name"] else 0,
        "ip": ip,
        "iface": iface,
        "app_pids": app,
        "uptime": uptime,
        "http": http_ok() if app else "",
        "deps": {
            "MySQL (3306)": bool(port_pids(3306)),
            "Redis (6379)": bool(port_pids(6379)),
            "Webpack (8090)": bool(port_pids(8090)),
        },
        "docker": docker_health(),
        "rider": rider_health(),
        "gradle_daemon": bool(sh("pgrep -f GradleDaemon")),
        "app_port": APP_PORT,
        "java": JAVA,
        "grails": GRAILS,
    }


def run_task(name, cmd, log):
    with _lock:
        if _task["name"]:
            return False, f"já existe uma ação em andamento: {_task['name']}"
        _task["name"] = name
        _task["started"] = time.time()

    def worker():
        try:
            with open(log, "w") as fh:
                fh.write(f"$ {name} — {time.strftime('%H:%M:%S')}\n")
            with open(log, "a") as out:
                proc = subprocess.Popen(
                    ["/usr/bin/script", "-q", "/dev/null", "/bin/zsh", "-c", cmd],
                    stdout=out, stderr=subprocess.STDOUT,
                    stdin=subprocess.DEVNULL, cwd=PROJECT,
                    start_new_session=True,
                )
            proc.wait()
        finally:
            if name != "start":
                _task["name"] = None

    threading.Thread(target=worker, daemon=True).start()
    return True, f"{name} iniciado"


# Preferimos a variante com tee: mesma coisa que run-asaas, mas espelha a saída no
# backend.log, o que mantém log e código OTP visíveis no painel.
START_CANDIDATES = ("run-asaas-tee", "run-asaas")


def shell_has(name):
    probes = (
        ("/opt/homebrew/bin/fish", ["-l", "-c", f"type -q {name}"]),
        ("/bin/zsh", ["-l", "-c", f"type {name} >/dev/null 2>&1"]),
        ("/bin/bash", ["-l", "-c", f"type {name} >/dev/null 2>&1"]),
    )
    for shell, args in probes:
        if not os.path.exists(shell):
            continue
        try:
            if subprocess.run([shell, *args], capture_output=True, timeout=12).returncode == 0:
                return True
        except (OSError, subprocess.SubprocessError):
            continue
    return False


def user_start_function():
    """Usa o atalho que a pessoa já tem no shell. Sem nenhum deles (colegas com outro
    setup), o chamador cai no script gerado."""
    for name in START_CANDIDATES:
        if shell_has(name):
            return name
    return None


def write_start_script():
    """Script próprio em vez de função de shell: funciona igual em zsh, bash ou fish."""
    body = f"""#!/bin/zsh
# Gerado pelo asaas-deck — inicia o backend Asaas (Grails {GRAILS}, porta {APP_PORT})
set -e
if [[ ! -s "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
\techo "SDKMAN não encontrado em ~/.sdkman — veja o README do asaas-core." >&2
\texit 1
fi
source "$HOME/.sdkman/bin/sdkman-init.sh"
sdk use java {JAVA}
sdk use grails {GRAILS}
cd {PROJECT}/web
grails run-app -Dserver.port={APP_PORT} 2>&1 | tee {BACKEND_LOG}
"""
    with open(START_SCRIPT, "w", encoding="utf-8") as fh:
        fh.write(body)
    os.chmod(START_SCRIPT, 0o755)
    return START_SCRIPT


ITERM_SCRIPT = """tell application "iTerm"
    activate
    set deckWindow to (create window with default profile)
    delay {delay}
    tell current session of deckWindow
        write text "{cmd}"
    end tell
end tell"""

TERMINAL_SCRIPT = """tell application "Terminal"
    activate
    set deckWindow to do script ""
    delay {delay}
    do script "{cmd}" in deckWindow
end tell"""


def terminal_app():
    """iTerm2 quando existir; senão o Terminal do macOS."""
    forced = setting("terminal")
    if forced:
        return forced
    return "iTerm" if os.path.isdir("/Applications/iTerm.app") else "Terminal"


def action_start():
    """Abre uma janela do terminal e injeta o comando de start — o startup do Grails precisa
    de um terminal de verdade, e assim o build fica visível para acompanhar/interromper."""
    if port_pids(APP_PORT, fresh=True):
        return False, f"backend já está rodando na porta {APP_PORT}"
    if not os.path.isdir(WEB):
        return False, f"projeto não encontrado em {PROJECT} (defina ASAAS_CORE_DIR)"
    with _lock:
        if _task["name"]:
            return False, f"já existe uma ação em andamento: {_task['name']}"
        _task["name"] = "start"
        _task["started"] = time.time()
    open(BACKEND_LOG, "w").close()
    cmd = setting("start_cmd") or user_start_function() or write_start_script()
    app = terminal_app()
    tpl = ITERM_SCRIPT if app == "iTerm" else TERMINAL_SCRIPT
    script = tpl.format(delay=TERM_DELAY, cmd=cmd.replace("\\", "\\\\").replace('"', '\\"'))
    r = subprocess.run(["/usr/bin/osascript", "-e", script], capture_output=True, text=True)
    if r.returncode != 0:
        _task["name"] = None
        err = r.stderr.strip()[:200]
        if "-1743" in err or "not allowed" in err.lower():
            err += " — autorize em Ajustes > Privacidade e Segurança > Automação."
        return False, f"falha ao abrir o {app}: {err}"
    curto = cmd if len(cmd) < 40 else os.path.basename(cmd)
    return True, f"{app} aberto; '{curto}' roda em {TERM_DELAY}s"


def action_stop():
    pids = port_pids(APP_PORT, fresh=True) + bootrun_pids()
    if not pids:
        _task["name"] = None
        return False, "backend não está rodando"
    for pid in set(pids):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    time.sleep(3)
    for pid in set(port_pids(APP_PORT, fresh=True) + bootrun_pids()):
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    _task["name"] = None
    return True, f"backend encerrado ({len(set(pids))} processo(s))"


def action_clean():
    if port_pids(APP_PORT):
        return False, "pare o backend antes de limpar"
    return run_task("clean", SDK + f"cd {WEB} && grails clean", TASK_LOG)


def action_stop_daemon():
    out = sh("pkill -f GradleDaemon && echo ok")
    return True, "daemon do Gradle encerrado" if out else "nenhum daemon rodando"


def action_docker_fix():
    """Derruba a VM travada e sobe tudo de novo, incluindo o MySQL do compose.

    O `rdctl shutdown` encerra a VM por fora — é o que resolve o congelamento sem
    perder imagens, containers ou volumes, que vivem no disco da VM. Como o backend
    é QEMU por exigência da VPN (decisão de DevTools), o congelamento pós-suspensão
    é recorrente e este caminho é o normal de recuperação, não uma medida extrema.
    """
    health = docker_health(ttl=0)
    if health["state"] == "ok":
        return False, f"Docker já está ativo (engine {health['version']})"
    if not RDCTL:
        return False, "rdctl não encontrado — defina ASAAS_RDCTL com o caminho"

    compose = ""
    if os.path.isfile(os.path.join(COMPOSE_DIR, "docker-compose.yaml")):
        compose = (f"echo '--- subindo containers' && cd {COMPOSE_DIR} && "
                   "docker compose up -d")
    # `rdctl shutdown` tenta encerrar a VM pelo guest — e no estado congelado o guest
    # é justamente o que não responde, então ele fica pendurado indefinidamente em vez
    # de falhar. Damos 45s e, se não voltar, derrubamos os processos da VM à força.
    # Fechar o app costuma levar o qemu junto; o kill cobre o caso de ele ficar órfão.
    cmd = (f"echo '--- encerrando a VM (até 45s)' && "
           f"( '{RDCTL}' shutdown & RD=$!; "
           "  for i in $(seq 1 45); do kill -0 $RD 2>/dev/null || break; sleep 1; done; "
           "  kill -0 $RD 2>/dev/null && { echo 'shutdown travou — encerrando à força'; "
           "    kill -TERM $RD 2>/dev/null; } ); "
           "osascript -e 'quit app \"Rancher Desktop\"' >/dev/null 2>&1 || true; sleep 5; "
           "pkill -TERM -f 'lima/bin/qemu-system' 2>/dev/null; "
           "pkill -TERM -f 'lima/bin/limactl hostagent' 2>/dev/null; sleep 5; "
           "pkill -KILL -f 'lima/bin/qemu-system' 2>/dev/null; "
           "pkill -KILL -f 'lima/bin/limactl hostagent' 2>/dev/null; sleep 2; "
           "echo '--- reabrindo o Rancher Desktop' && open -a 'Rancher Desktop' && "
           # medido: ~90s num restart limpo; a folga cobre boot após kill forçado
           "echo '--- aguardando o dockerd (até 240s)' && "
           "for i in $(seq 1 80); do "
           "  docker info >/dev/null 2>&1 && echo 'engine no ar' && break; "
           "  sleep 3; done && "
           "docker info >/dev/null 2>&1 || { echo 'engine nao subiu a tempo'; exit 1; }"
           + (" && " + compose if compose else ""))
    ok, msg = run_task("docker-fix", cmd, TASK_LOG)
    if ok:
        _docker_cache["t"] = 0.0
        return True, "reiniciando o Docker — acompanhe no log (leva ~1-2 min)"
    return ok, msg



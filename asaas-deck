def sh(cmd, timeout=10):
    try:
        r = subprocess.run(["/bin/zsh", "-c", cmd], capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip()
    except Exception:
        return ""


_ports_cache = {"t": 0.0, "data": {}}


def listeners(ttl=2.0):
    """Uma única chamada de lsof para todas as portas: 4 chamadas por refresh custavam ~5s."""
    now = time.time()
    if now - _ports_cache["t"] < ttl:
        return _ports_cache["data"]
    data = {}
    for line in sh("lsof -nP -iTCP -sTCP:LISTEN").split("\n")[1:]:
        parts = line.split()
        if len(parts) < 9 or not parts[1].isdigit():
            continue
        addr = parts[8]
        if ":" not in addr:
            continue
        port = addr.rsplit(":", 1)[1]
        if port.isdigit():
            data.setdefault(int(port), []).append(int(parts[1]))
    _ports_cache.update(t=now, data=data)
    return data


def port_pids(port, fresh=False):
    if fresh:
        _ports_cache["t"] = 0.0
    return listeners().get(port, [])


def local_ip():
    for iface in ("en0", "en1", "en2"):
        ip = sh(f"ipconfig getifaddr {iface}")
        if ip:
            return ip, iface
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip, "auto"
    except Exception:
        return "127.0.0.1", "loopback"


def bootrun_pids():
    out = sh("ps -axo pid,args | grep -i '[b]ootRun\\|[g]rails run-app' | awk '{print $1}'")
    return [int(p) for p in out.split() if p.isdigit()]


ANSI = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]|\x1b\][^\x07]*\x07|[\x00-\x08\x0b\x0c\x0e-\x1f]")
# o gradle desenha a barra de progresso sem quebra de linha, colando-a no log da aplicação:
# removemos os trechos de progresso de dentro da linha em vez de descartar a linha inteira
PROGRESS = re.compile(
    r"<[-=>\s]*>\s*\d+%\s*(?:EXECUTING|CONFIGURING|INITIALIZING|WAITING)?(?:\s*\[[^\]]*\])?"
    r"|>\s*(?::[\w:.\-]+|IDLE|Starting Daemon|Connecting to Daemon|root project"
    r"|Evaluating settings|Loading projects|Resolve [^<>\n]*)"
)


def read_log(path, limit=400000):
    if not os.path.exists(path):
        return ""
    try:
        with open(path, "rb") as fh:
            fh.seek(0, os.SEEK_END)
            fh.seek(max(0, fh.tell() - limit))
            raw = fh.read().decode("utf-8", "replace")
    except OSError:
        return ""
    return ANSI.sub("", raw.replace("\r\n", "\n").replace("\r", "\n"))


def tail(path, n=200):
    out, seen = [], None
    for chunk in read_log(path).split("\n"):
        line = " ".join(PROGRESS.sub(" ", chunk).split())
        if len(line) < 4 or set(line) <= set("<>=- ") or line == seen:
            continue
        seen = line
        out.append(line)
    return "\n".join(out[-n:])


def active_log():
    """Mostra o log da última ação executada, para o resultado não desaparecer ao terminar."""
    if _task["name"] in ("clean", "docker-fix", "rider-fix"):
        return TASK_LOG
    if _task["name"] == "start":
        return BACKEND_LOG
    existing = [f for f in (BACKEND_LOG, TASK_LOG) if os.path.exists(f)]
    return max(existing, key=os.path.getmtime) if existing else BACKEND_LOG


def mobile_status(current_ip=None):
    """IP e e-mail que estão hoje no DebugSettings.cs de cada app mobile."""
    out = []
    for name, path in MOBILE_FILES:
        entry = {"name": name, "ip": None, "email": None, "exists": os.path.exists(path)}
        if entry["exists"]:
            try:
                src = open(path, encoding="utf-8").read()
                m = IP_RE.search(src)
                entry["ip"] = m.group(2) if m else None
                me = EMAIL_RE.search(src)
                entry["email"] = me.group(2) if me else None
            except OSError:
                pass
        entry["synced"] = bool(current_ip) and entry["ip"] == current_ip
        out.append(entry)
    return out


def action_inject_ip():
    """Grava o IP local no IP_ADDRESS dos DebugSettings.cs dos dois apps."""
    ip, _ = local_ip()
    done, skipped, failed = [], [], []
    for name, path in MOBILE_FILES:
        if not os.path.exists(path):
            failed.append(f"{name} (arquivo não encontrado)")
            continue
        try:
            src = open(path, encoding="utf-8").read()
            m = IP_RE.search(src)
            if not m:
                failed.append(f"{name} (IP_ADDRESS não encontrado)")
                continue
            if m.group(2) == ip:
                skipped.append(name)
                continue
            open(path, "w", encoding="utf-8").write(IP_RE.sub(rf"\g<1>{ip}\g<3>", src, count=1))
            done.append(f"{name}: {m.group(2)} -> {ip}")
        except OSError as exc:
            failed.append(f"{name} ({exc})")
    parts = []
    if done:
        parts.append("atualizado " + "; ".join(done))
    if skipped:
        parts.append(f"já em {ip}: " + ", ".join(skipped))
    if failed:
        parts.append("falhou: " + "; ".join(failed))
    return not failed, " | ".join(parts) or "nada a fazer"


def action_set_email(name, email):
    """Grava o LoginUsername do DebugSettings.cs de um app."""
    email = (email or "").strip()
    if not VALID_EMAIL.match(email):
        return False, f"e-mail inválido: {email!r}"
    target = dict(MOBILE_FILES).get(name)
    if not target:
        return False, f"app desconhecido: {name}"
    if not os.path.exists(target):
        return False, f"arquivo não encontrado: {target}"
    try:
        src = open(target, encoding="utf-8").read()
        m = EMAIL_RE.search(src)
        if not m:
            return False, "LoginUsername não encontrado no arquivo"
        if m.group(2) == email:
            return True, f"{name} já estava com {email}"
        open(target, "w", encoding="utf-8").write(EMAIL_RE.sub(rf"\g<1>{email}\g<3>", src, count=1))
        return True, f"{name}: {m.group(2)} -> {email}"
    except OSError as exc:
        return False, f"falha ao gravar: {exc}"


def find_otp():
    """Último código OTP visto no log do backend."""
    hit = None
    for line in PROGRESS.sub(" ", read_log(active_log())).split("\n"):
        for pattern in OTP_PATTERNS:
            m = pattern.search(line)
            if m:
                clean = " ".join(line.split())
                phone = PHONE_RE.search(clean)
                hit = {"code": m.group(1), "to": phone.group(1) if phone else None,
                       "line": clean[-180:]}
                break
    return hit



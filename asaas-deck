class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, body, ctype="application/json"):
        data = body.encode()
        self.send_response(200)
        self.send_header("Content-Type", f"{ctype}; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/":
            self._send(PAGE, "text/html")
        elif self.path == "/api/status":
            self._send(json.dumps(status()))
        elif self.path == "/api/logs":
            self._send(tail(active_log()), "text/plain")
        else:
            self.send_error(404)

    def do_POST(self):
        actions = {"/api/start": action_start, "/api/stop": action_stop,
                   "/api/clean": action_clean, "/api/daemon": action_stop_daemon,
                   "/api/inject-ip": action_inject_ip,
                   "/api/docker-fix": action_docker_fix,
                   "/api/rider-diag": action_rider_diag,
                   "/api/rider-fix": action_rider_fix}
        if self.path == "/api/set-email":
            b = self._body()
            ok, msg = action_set_email(b.get("name"), b.get("email"))
            return self._send(json.dumps({"ok": ok, "message": msg}))
        fn = actions.get(self.path)
        if not fn:
            return self.send_error(404)
        ok, msg = fn()
        self._send(json.dumps({"ok": ok, "message": msg}))

    def _body(self):
        try:
            n = int(self.headers.get("Content-Length") or 0)
            return json.loads(self.rfile.read(n) or b"{}")
        except (ValueError, json.JSONDecodeError):
            return {}


class Server(ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True


if __name__ == "__main__":
    url = f"http://localhost:{DECK_PORT}"
    try:
        srv = Server(("127.0.0.1", DECK_PORT), Handler)
    except OSError as exc:
        if exc.errno != 48:
            raise
        alive = sh(f"curl -s -o /dev/null -w '%{{http_code}}' --max-time 3 {url}/api/status")
        if alive == "200":
            print(f"Já existe um AsaasDeck rodando: {url}")
        else:
            pids = " ".join(sh(f"lsof -ti:{DECK_PORT}").split()) or "?"
            print(f"Porta {DECK_PORT} ocupada por outro processo (PID: {pids}).")
            print(f"Use outra porta: ASAAS_DECK_PORT=7071 asaas-deck")
        raise SystemExit(1)
    print(f"AsaasDeck: {url}  (Ctrl+C para sair)")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nPainel encerrado. O backend continua rodando (use Parar no painel para encerrá-lo).")
